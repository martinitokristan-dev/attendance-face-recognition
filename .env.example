# ─── Copy this file to .env and fill in your values ───────────────────────────
# NEVER commit .env to git

# Django Core
SECRET_KEY=django-change-this-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ─── Database Configuration ──────────────────────────────────────────────────
# Choose ONE of the following options:

# ── OPTION 1: TiDB Cloud (Serverless / Dedicated) ───────────────────────────
DB_ENGINE=django.db.backends.mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com   # TiDB Cloud Host
DB_PORT=4000                                              # TiDB default port is 4000
DB_USER=your_prefix.root                                  # TiDB username
DB_PASSWORD=your_tidb_password                            # TiDB password
DB_NAME=attendance_FR                                     # TiDB database name
DB_USE_SSL=True                                           # TiDB Cloud requires SSL
DB_SSL_CA=isrgrootx1.pem                                  # Uses isrgrootx1.pem certificate in project root

# ── OPTION 2: Local XAMPP MySQL / phpMyAdmin ────────────────────────────────
# (Uncomment below and comment out Option 1 if running locally on XAMPP)
# DB_ENGINE=django.db.backends.mysql
# DB_NAME=attendance_db
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USE_SSL=False

# ─── Face Recognition ─────────────────────────────────────────────────────────
# Lower tolerance = stricter matching (0.38 recommended; rejects look-alikes)
FACE_RECOGNITION_TOLERANCE=0.38
MIN_FACE_CONFIDENCE=0.62
FACE_MATCH_MARGIN=0.08
FACE_CONSENSUS_FRAMES=2
# Match confidence (0–1) at or above this marks on the first good frame (~1.5s per student)
FACE_INSTANT_MARK_CONFIDENCE=0.70
LATE_THRESHOLD_MINUTES=15

# ─── Cache (locmem for dev, Redis URL for prod) ────────────────────────────────
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache

# ─── Cloudinary Persistent Media (Face & Profile Images on Cloud) ───────────
# Free account at https://cloudinary.com -> Dashboard:
# (Optional for local dev - if blank, files save locally in media/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
